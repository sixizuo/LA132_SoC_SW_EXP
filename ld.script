/*
 * loongson software
 */
OUTPUT_FORMAT("elf32-loongarch")

OUTPUT_ARCH(loongarch)
ENTRY(_start)
MEMORY
{
    flash(R) : ORIGIN = 0x1c000000, LENGTH = 64K
    iram(RW) : ORIGIN = _RAM_BSS, LENGTH = 4K
    dram(RW) : ORIGIN = _RAM_DATA, LENGTH = 4K
}
SECTIONS
{
	.text	: 
    { 
        . = ALIGN(4);
        *(.text .text.*) 
        . = ALIGN(4);
        _etext = .;
    } > flash
    
	.rodata  : 
    { 
        . = ALIGN(4);
        *(.rodata .rodata.*) 
        . = ALIGN(4);
        _sidata = ALIGN(.,4);
        . = ALIGN(4);
    } > flash
    
	.data  : AT(_sidata)
    {
        _sdata = .;
        . = ALIGN(4);
        *(.got.plt) 
        . = ALIGN(4);
        *(.got) 
        . = ALIGN(4);
        *(.data .data.*) 
        . = ALIGN(4);
        _edata = .;
    } > dram
    
    .bss :
    {
        _sbss = .; /* BSS */
        . = ALIGN(4);
        /* ★ 必须带上 .sbss.* / .bss.* 这两种"每变量一节"的子段。
         *   编译器开了 -fdata-sections 之后, 每个静态变量都变成独立的
         *   .bss.<变量名> 输入段 (map 里能看到 .bss.s_irq_rx_mode /
         *   .bss.s_rx_tail 这种)。原来这里只写了 *(.bss) 和 *(.sbss),
         *   一个都匹配不到 -> 整个 .bss 输出段大小是 0 ->
         *   _sbss == _ebss == 0x80000000 -> start.S 里那句
         *       beq t1, t0, cpu_init_start
         *   直接跳过清零, 所有静态变量保留的是 FPGA BRAM 里的残留值!
         *   表现就是: 计数器一上电就是 488 万次中断、uart 的
         *   s_irq_rx_mode 残留成 1 导致轮询永远返回 -1 (收不到字节)。
         *   这些变量变成了"孤儿段"被链接器丢在 .bss 输出段之后,
         *   地址 0x8000000C ~ 0x8000009C, 谁也不管。 */
        *(.sbss .sbss.*)
        . = ALIGN(4);
        *(.bss .bss.*)
        . = ALIGN(4);
        *(.scommon)
        . = ALIGN(4);
        *(COMMON) 
        . = ALIGN(4);
        _ebss = . ;	 
    } > iram
}
